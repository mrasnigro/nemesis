# IMP Platform — local environment template (names / safe placeholders only)
# Copy to .env or .env.local and fill values. Do not commit real secrets.

# Absolute URL of the legacy Webinar FE (sidecar fallback — new tab)
VITE_WEBINAR_URL=http://localhost:3000

# In-app Webinar API (M1). Prefer same-origin proxy path; Vite rewrites to :3001/api
VITE_WEBINAR_API_URL=/webinar-api

# Optional absolute override if not using the Vite proxy:
# VITE_WEBINAR_API_URL=http://localhost:3001/api

# Dev-only shared key for IMP→Webinar handoff (must match IMP_HANDOFF_SHARED_KEY)
VITE_IMP_HANDOFF_SHARED_KEY=imp-dev-handoff-key

# Training IA provider (offline). Default: llm-mock
VITE_TRAINING_AI_PROVIDER=llm-mock

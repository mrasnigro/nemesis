# IMP Platform — local environment template (names / safe placeholders only)
# Copy to .env or .env.local and fill values. Do not commit real secrets.

# Absolute URL of the Webinar sidecar (opened in a new tab from /modules/webinar)
VITE_WEBINAR_URL=http://localhost:3000

# Training IA provider (offline). Default: llm-mock
#   llm-mock — async DNA replies + rubric judge contract (no network)
#   mock     — classic sync rule/script replies; keyword scoring only
VITE_TRAINING_AI_PROVIDER=llm-mock

# Future (not wired): OpenAI-compatible chat for real LLM
# VITE_TRAINING_AI_LLM_BASE_URL=https://api.openai.com/v1
# VITE_TRAINING_AI_LLM_MODEL=gpt-4o-mini
# VITE_TRAINING_AI_LLM_API_KEY=

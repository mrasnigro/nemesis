{
  "name": "CRM IMP",
  "version": "1.0.0",
  "rootDirectory": "crm-imp-hostinger-v2",
  "framework": "nodejs",
  "buildCommand": "bash build.sh",
  "startCommand": "bash start.sh",
  "buildDirectory": "backend/dist",
  "staticDirectory": "frontend/dist",
  "nodeVersion": "18.x",
  "packageManager": "npm",
  "installCommand": "npm install",
  "enviromentVariables": {
    "NODE_ENV": "production",
    "PORT": "3000"
  },
  "install": {
    "timeout": 600
  },
  "build": {
    "timeout": 900
  },
  "start": {
    "timeout": 60
  },
  "healthCheck": {
    "path": "/health",
    "interval": 10,
    "timeout": 5
  }
}

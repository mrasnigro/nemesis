# Copy to apps/api/.env. Local values only. Do not commit .env.

PORT=4000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=imp
DB_PASSWORD=imp
DB_NAME=imp

JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local shell still uses mock login. When true, the API accepts X-Dev-User.
# Leave unset in any deployed environment.
ALLOW_DEV_AUTH=true
SEED_USERNAME=imp
SEED_PASSWORD=imp
SEED_NAME=IMP User

# Discagem Automática telephony.
# Per-customer provider settings live in MySQL (npm run telephony -- --help in scripts/telephony.ts).
# Customers without settings fall back to this provider. "simulated" works only outside production.
TELEPHONY_DEFAULT_PROVIDER=simulated
# Encrypts the FaleVono API token/key at rest. Required before saving FaleVono credentials. 32+ chars.
TELEPHONY_SECRET_KEY=replace-with-at-least-32-random-characters
# Time zone of the PABX clock, used to query its call and recording reports.
PABX_TIMEZONE=America/Sao_Paulo
# Where call recordings copied from the PABX are stored (relative to the API working dir).
RECORDINGS_DIR=storage/recordings

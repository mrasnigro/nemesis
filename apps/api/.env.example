# Copy to apps/api/.env. Local values only. Do not commit .env.

PORT=4000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=imp
DB_PASSWORD=imp
DB_NAME=imp

JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local shell still uses mock login. When true, the API accepts X-Dev-User.
# Leave unset in any deployed environment.
ALLOW_DEV_AUTH=true
SEED_USERNAME=imp
SEED_PASSWORD=imp
SEED_NAME=IMP User

# Copy to apps/api/.env. Local values only. Do not commit .env.

PORT=4000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=imp
DB_PASSWORD=imp
DB_NAME=imp
# Aiven only. Set DB_SSL=true and DB_SSL_CA to the downloaded CA PEM (or a path to that file).
# DB_SSL=true
# DB_SSL_CA=

# Same-process deploy (Hostinger): serve apps/web/dist from this API process.
# Leave unset to auto-detect apps/web/dist after `npm run build`.
# WEB_DIST_DIR=apps/web/dist
# Apply pending migrations when the API starts (default on). Set false only if you migrate out of band.
# RUN_MIGRATIONS_ON_START=true

JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to 1 when the API runs behind one reverse proxy (nginx/Hostinger) so rate limits see the client IP.
TRUST_PROXY=false
# Login attempts allowed per IP + username every 15 minutes.
LOGIN_RATE_LIMIT_MAX=10

# Optional: lets curl/scripts call the API with an `X-Dev-User: <username>` header instead of a cookie.
# The web app never sends it. Ignored when NODE_ENV=production.
ALLOW_DEV_AUTH=false

# `npm run db:seed`. In development it creates demo customers and users (admin/admin, bdr/bdr, sdr/sdr,
# gestor/gestor, imp/imp). In production it only creates the platform administrator and requires a
# SEED_ADMIN_PASSWORD of 12+ characters.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin
SEED_USERNAME=imp
SEED_PASSWORD=imp
SEED_NAME=IMP User

# Webinar (services/webinar). The API mints one-time sign-on codes server-to-server with this key;
# it must equal IMP_HANDOFF_SHARED_KEY in the Webinar backend. Never expose it to the browser.
WEBINAR_API_URL=http://127.0.0.1:3001/api
WEBINAR_HANDOFF_SHARED_KEY=imp-dev-handoff-key

# Discagem Automática telephony.
# Per-customer provider settings live in MySQL (npm run telephony -- --help in scripts/telephony.ts).
# Customers without settings fall back to this provider. "simulated" works only outside production.
TELEPHONY_DEFAULT_PROVIDER=simulated
# Encrypts the FaleVono API token/key at rest. Required before saving FaleVono credentials. 32+ chars.
TELEPHONY_SECRET_KEY=replace-with-at-least-32-random-characters
# Time zone of the PABX clock, used to query its call and recording reports.
PABX_TIMEZONE=America/Sao_Paulo
# Where call recordings copied from the PABX are stored (relative to the API working dir).
RECORDINGS_DIR=storage/recordings

# Treinamento IA. "builtin" is a rule-based stand-in for development and tests; production refuses it.
# "openai" works with any OpenAI-compatible chat completions API (OpenAI, Azure OpenAI gateway, OpenRouter, vLLM...).
TRAINING_AI_PROVIDER=builtin
# TRAINING_AI_BASE_URL=https://api.openai.com/v1
# TRAINING_AI_API_KEY=
# TRAINING_AI_MODEL=gpt-4o-mini
# TRAINING_AI_TIMEOUT_MS=30000
# Trainee messages allowed in one session.
# TRAINING_AI_MAX_TURNS=40
# LLM_API_KEY / LLM_BASE_URL / LLM_MODEL are accepted as aliases of the TRAINING_AI_* values above.
# Voice replies: lets a reasoning model answer sooner (none | minimal | low | medium | high). Leave unset unless your model supports it.
# TRAINING_AI_REASONING_EFFORT=low

# Treinamento IA voice calls: the server listens (STT), the language model above answers, the server speaks (TTS).
# With TRAINING_AI_API_KEY set on OpenAI this works with no extra variables (whisper-1 + tts-1).
# Any OpenAI-compatible speech API works (Groq, a local Kokoro-FastAPI...). Without a key the browser's own
# recognition and voice are used. Set a model to "off" to disable that stage.
# STT_PROVIDER=openai          # or deepgram: faster for short turns (own /listen API, needs its own STT_API_KEY)
# STT_BASE_URL=https://api.openai.com/v1
# STT_API_KEY=
# STT_MODEL=whisper-1        # nova-3 when STT_PROVIDER=deepgram
# TTS_BASE_URL=https://api.openai.com/v1
# TTS_API_KEY=
# TTS_MODEL=tts-1
# Voice per persona gender. Kokoro: pf_dora / pm_alex. OpenAI: nova / onyx.
# TTS_VOICE_FEMALE=nova
# TTS_VOICE_MALE=onyx
# Pace of the persona's voice, applied by the page (1 = provider's natural pace).
# TTS_SPEED=1.15

# Discagem Automática call summary and transcription. Without a key, each call still gets a summary
# built from the attendance record. With a key, an AI summary is written when the call is saved and
# redone from the transcript once the recording is copied from the PABX.
# Each value falls back to its TRAINING_AI_* counterpart. Transcription needs /audio/transcriptions
# (OpenAI, Azure OpenAI); set CALL_TRANSCRIBE_MODEL=off for providers without it (e.g. OpenRouter).
# CALL_AI_BASE_URL=https://api.openai.com/v1
# CALL_AI_API_KEY=
# CALL_AI_MODEL=gpt-4o-mini
# CALL_TRANSCRIBE_MODEL=whisper-1
# CALL_AI_TIMEOUT_MS=120000

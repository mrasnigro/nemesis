# Service-root env for npm start / deployment/server.js
# Copy to `.env` and/or `.env.production` (do not commit real values).
# For local `backend` `npm run dev`, prefer `backend/.env` (same keys).

PORT=3001
NODE_ENV=production
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=imp
DB_PASSWORD=
DB_NAME=imp_webinar
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
# Must equal WEBINAR_HANDOFF_SHARED_KEY in the IMP API env.
IMP_HANDOFF_SHARED_KEY=
CORS_ORIGINS=

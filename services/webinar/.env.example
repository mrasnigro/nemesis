# Service-root env for npm start / deployment/server.js
# Copy to `.env` and/or `.env.production` (do not commit real values).
# For local `backend` `npm run dev`, prefer `backend/.env` (same keys).

PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
JWT_SECRET=dev-change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=dev-change-me-refresh-secret-min-32-chars!
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
NODE_ENV=development
# IMP → Webinar SSO handoff (Phase C). Must match IMP VITE_IMP_HANDOFF_SHARED_KEY
IMP_HANDOFF_SHARED_KEY=imp-dev-handoff-key

# Service-root env for npm start / deployment/server.js
# Copy to .env and .env.production (do not commit real values).
# Also copy to backend/.env when running tools from backend/.

PORT=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRY=
JWT_REFRESH_EXPIRY=
NODE_ENV=
# IMP → Webinar SSO handoff (Phase C). Must match IMP VITE_IMP_HANDOFF_SHARED_KEY
IMP_HANDOFF_SHARED_KEY=imp-dev-handoff-key


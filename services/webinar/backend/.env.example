# Prefer SQLite file under services/webinar/database (local IMP/dev).
# MYSQL keys below are legacy / optional for remote deploy only.

PORT=3001
SQLITE_PATH=database/sqlite.db

# Legacy MySQL (unused when SQLITE_PATH is set)
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

JWT_SECRET=dev-change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=dev-change-me-refresh-secret-min-32-chars!
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
NODE_ENV=production
IMP_HANDOFF_SHARED_KEY=imp-dev-handoff-key

# Comma-separated list of extra allowed CORS origins (e.g. your Netlify frontend URL).
# Defaults (localhost + s1m0ne.tec.br) are always allowed; this just adds more.
CORS_ORIGINS=https://impcentral.netlify.app/login

PORT=3001
NODE_ENV=development

# MySQL — the Webinar module owns its own database on the shared IMP MySQL server.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=imp
DB_PASSWORD=
DB_NAME=imp_webinar

JWT_SECRET=dev-change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=dev-change-me-refresh-secret-min-32-chars!
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Must equal WEBINAR_HANDOFF_SHARED_KEY in apps/api/.env (required in production).
IMP_HANDOFF_SHARED_KEY=imp-dev-handoff-key

# Comma-separated extra CORS origins (scheme + host[:port], no path).
CORS_ORIGINS=http://localhost:5173

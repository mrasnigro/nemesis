{
  "name": "imp-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "npm run dev -w @imp/web",
    "dev:api": "npm run dev -w @imp/api",
    "dev:webinar": "npm --prefix services/webinar/backend run dev",
    "dev:all": "concurrently -k -n api,web,webinar -c blue,green,magenta \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:webinar\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:asterisk": "npm run test:asterisk -w @imp/api",
    "db:up": "docker compose up -d mysql",
    "db:migrate": "npm run migrate -w @imp/api",
    "db:seed": "npm run seed -w @imp/api",
    "webinar:install": "npm --prefix services/webinar/backend ci",
    "webinar:migrate": "npm --prefix services/webinar/backend run migrate",
    "webinar:seed": "npm --prefix services/webinar/backend run seed",
    "webinar:typecheck": "npm --prefix services/webinar/backend run typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
